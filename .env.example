# Local connection profile. Copy to a protected environment-specific file or
# inject through your process manager. Never commit real values.
REMBRANE_DATABASE=.rembrane/rembrane.db
REMBRANE_PRINCIPAL_ID=
REMBRANE_WORKSPACE_ID=
REMBRANE_CLIENT_ID=
# Exact connection-owned allowlist. No wildcards.
# Example: global,domain:development,entity:project_01,activity:task_01
REMBRANE_READ_SCOPES=global
# Optional comma-separated sensitive read capabilities. Leave empty by default.
# Supported: travel-source-references,travel-sensitive-profile
REMBRANE_READ_PERMISSIONS=

# Development cipher only. Production deployments must use an OS keychain,
# HSM, or customer-controlled KMS provider.
REMBRANE_WORKSPACE_KEY_ID=
REMBRANE_WORKSPACE_KEY_HEX=
REMBRANE_WORKSPACE_KEY_REFERENCE=
REMBRANE_WORKSPACE_KEY_FILE=

# macOS Keychain. These values are lookup metadata, not key material.
# REMBRANE_KEY_PROVIDER=macos-keychain
REMBRANE_KEYCHAIN_SERVICE=
REMBRANE_KEYCHAIN_ACCOUNT=
# Comma-separated key_id=account entries using the same Keychain service.
REMBRANE_KEYCHAIN_HISTORICAL_KEYS=

# Linux Secret Service. These values are lookup metadata, not key material.
# REMBRANE_KEY_PROVIDER=linux-secret-service
REMBRANE_SECRET_SERVICE_SERVICE=
REMBRANE_SECRET_SERVICE_ACCOUNT=
REMBRANE_SECRET_SERVICE_HISTORICAL_KEYS=

# Windows DPAPI (CurrentUser). Paths and key IDs are lookup metadata.
# REMBRANE_KEY_PROVIDER=windows-dpapi
REMBRANE_DPAPI_BLOB_PATH=
# Comma-separated key_id=C:\absolute\path.dpapi entries.
REMBRANE_DPAPI_HISTORICAL_KEYS=

# Customer-controlled Key Provider Protocol sidecar. When selected, local raw
# workspace-key variables above are ignored. Keep the bearer token in a secret
# manager or protected process environment.
# REMBRANE_KEY_PROVIDER=http
REMBRANE_KEY_PROVIDER_BASE_URL=
REMBRANE_KEY_PROVIDER_TOKEN=
REMBRANE_KEY_PROVIDER_TOKEN_REFERENCE=
# Optional policy overrides:
# REMBRANE_KEY_PROVIDER_ALGORITHM=xchacha20poly1305-ietf
# REMBRANE_KEY_PROVIDER_MINIMUM_PLAINTEXT_BYTES=262144
# REMBRANE_KEY_PROVIDER_REQUIRE_HISTORICAL_KEYS=true
# REMBRANE_KEY_PROVIDER_REQUEST_PREFIX=

# Local REST server.
REMBRANE_API_TOKEN=
REMBRANE_API_TOKEN_REFERENCE=
REMBRANE_API_TOKEN_FILE=
REMBRANE_LISTEN=127.0.0.1:8787
REMBRANE_PUBLIC_API_URL=http://127.0.0.1:8787/v1
REMBRANE_ALLOW_NON_LOOPBACK=0
# Configure the complete validated profile to publish remote MCP
# protected-resource discovery. Secret values remain behind references.
REMBRANE_MCP_RESOURCE=
REMBRANE_OAUTH_ISSUER=
REMBRANE_OAUTH_INTROSPECTION_ENDPOINT=
REMBRANE_OAUTH_INTROSPECTION_CLIENT_ID=
REMBRANE_OAUTH_INTROSPECTION_CLIENT_SECRET_REFERENCE=
# Comma-separated exact HTTPS browser origins; leave empty for non-browser
# clients.
REMBRANE_MCP_TRUSTED_ORIGINS=

# Optional Cloudflare Tunnel sidecar. Keep the token only in the deployment
# secret manager or protected local environment file. Pin the image digest in
# production.
CLOUDFLARE_TUNNEL_TOKEN_FILE=
CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.7.0

# Optional user-controlled WhatsApp Business gateway. Generate three distinct,
# high-entropy values and inject them through a protected deployment secret
# store. The binding lookup secret must remain stable across restarts.
REMBRANE_WHATSAPP_APP_SECRET=
REMBRANE_WHATSAPP_APP_SECRET_REFERENCE=
REMBRANE_WHATSAPP_APP_SECRET_FILE=
REMBRANE_WHATSAPP_BINDING_LOOKUP_SECRET=
REMBRANE_WHATSAPP_BINDING_LOOKUP_SECRET_REFERENCE=
REMBRANE_WHATSAPP_BINDING_LOOKUP_SECRET_FILE=
REMBRANE_WHATSAPP_WEBHOOK_VERIFICATION_TOKEN=
REMBRANE_WHATSAPP_WEBHOOK_VERIFICATION_TOKEN_REFERENCE=
REMBRANE_WHATSAPP_WEBHOOK_VERIFICATION_TOKEN_FILE=
REMBRANE_WHATSAPP_MAXIMUM_EVENT_AGE_SECONDS=300
REMBRANE_WHATSAPP_REPLAY_WINDOW_SECONDS=604800
REMBRANE_WHATSAPP_MAXIMUM_REPLAY_EVENTS=1000000
REMBRANE_CHANNEL_PROCESSOR_URL=
REMBRANE_CHANNEL_PROCESSOR_TOKEN=
REMBRANE_CHANNEL_PROCESSOR_TOKEN_REFERENCE=
REMBRANE_CHANNEL_PROCESSOR_TOKEN_FILE=
REMBRANE_CHANNEL_WORKER_BATCH_SIZE=10
REMBRANE_CHANNEL_WORKER_POLL_MILLISECONDS=1000
REMBRANE_CHANNEL_WORKER_MAXIMUM_ATTEMPTS=5
REMBRANE_CHANNEL_WORKER_RETRY_DELAY_SECONDS=30
REMBRANE_CHANNEL_WORKER_LEASE_SECONDS=300

# Optional explicit mobile-share companion. The account and device identifiers
# are needed only while running the audited bind/unbind CLI command.
REMBRANE_MOBILE_SHARE_SIGNING_SECRET=
REMBRANE_MOBILE_SHARE_SIGNING_SECRET_REFERENCE=
REMBRANE_MOBILE_SHARE_SIGNING_SECRET_FILE=
REMBRANE_MOBILE_SHARE_BINDING_LOOKUP_SECRET=
REMBRANE_MOBILE_SHARE_BINDING_LOOKUP_SECRET_REFERENCE=
REMBRANE_MOBILE_SHARE_BINDING_LOOKUP_SECRET_FILE=
REMBRANE_MOBILE_SHARE_ACCOUNT_ID=
REMBRANE_MOBILE_SHARE_DEVICE_ID=
REMBRANE_MOBILE_SHARE_MAXIMUM_EVENT_AGE_SECONDS=300
REMBRANE_MOBILE_SHARE_REPLAY_WINDOW_SECONDS=604800
REMBRANE_MOBILE_SHARE_MAXIMUM_REPLAY_EVENTS=100000

# Optional bring-your-own providers. Credentials stay in this deployment and
# are resolved by adapters; never put them in canonical memory or URLs.
MEM0_BASE_URL=
MEM0_API_KEY=
MEM0_API_KEY_REFERENCE=
# Independent 32+ byte secret used only to pseudonymize workspace identifiers.
MEM0_WORKSPACE_LOOKUP_SECRET=
MEM0_WORKSPACE_LOOKUP_SECRET_REFERENCE=
SUPERMEMORY_BASE_URL=
SUPERMEMORY_API_KEY=
SUPERMEMORY_API_KEY_REFERENCE=
# Independent 32+ byte secret used only to pseudonymize workspace namespaces.
SUPERMEMORY_WORKSPACE_LOOKUP_SECRET=
SUPERMEMORY_WORKSPACE_LOOKUP_SECRET_REFERENCE=
REMBRANE_GRAPH_PROVIDER=native
REMBRANE_GRAPH_PROVIDER_ALLOW_PLAINTEXT=false
REMBRANE_GRAPHITI_BASE_URL=
REMBRANE_GRAPHITI_BEARER_TOKEN=
# Prefer a protected reference outside local development. Graph worker
# composition may require its own file-mounted credential input.
REMBRANE_GRAPHITI_BEARER_TOKEN_REFERENCE=
REMBRANE_GRAPHITI_BEARER_TOKEN_FILE=
REMBRANE_GRAPHITI_NEO4J_AUTH_FILE=
REMBRANE_GRAPHITI_OPENAI_API_KEY_FILE=

# Optional portable Memory Provider Protocol endpoint. Supply the bearer
# credential directly through the environment or select a protected local
# reference such as file:/run/secrets/memory-provider-token.
REMBRANE_MEMORY_PROVIDER=http
REMBRANE_MEMORY_PROVIDER_BASE_URL=
REMBRANE_MEMORY_PROVIDER_TOKEN=
REMBRANE_MEMORY_PROVIDER_TOKEN_REFERENCE=
REMBRANE_MEMORY_PROVIDER_REQUEST_PREFIX=

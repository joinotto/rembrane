{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.rembrane.dev/memory-provider/0.1/conformance-result.schema.json",
  "title": "Rembrane Memory Provider Conformance Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profileId",
    "fixtureId",
    "protocolVersion",
    "provider",
    "result",
    "namespace",
    "cases"
  ],
  "properties": {
    "profileId": {
      "const": "rembrane.memory-provider.core"
    },
    "fixtureId": {
      "const": "rembrane.memory-provider.core.lifecycle"
    },
    "protocolVersion": {
      "const": "0.1"
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]+$",
          "maxLength": 255
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    },
    "result": {
      "const": "pass"
    },
    "namespace": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,64}$"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "result"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]+$",
            "maxLength": 255
          },
          "result": {
            "const": "pass"
          }
        }
      }
    }
  }
}

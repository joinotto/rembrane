{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.rembrane.dev/key-provider/0.1/conformance-result.schema.json",
  "title": "Rembrane Key Provider Conformance Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profileId",
    "profileSha256",
    "protocolVersion",
    "providerId",
    "providerVersion",
    "result",
    "namespace",
    "cases"
  ],
  "properties": {
    "profileId": {
      "const": "rembrane.key-provider.core"
    },
    "profileSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "protocolVersion": {
      "const": "0.1"
    },
    "providerId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]+$",
      "maxLength": 255
    },
    "providerVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "result": {
      "const": "pass"
    },
    "namespace": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,80}$"
    },
    "cases": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "result"],
        "properties": {
          "id": {
            "enum": [
              "authentication",
              "manifest",
              "roundtrip",
              "context-substitution",
              "unknown-key",
              "plaintext-limit",
              "rotation",
              "repeated-rotation"
            ]
          },
          "result": {
            "const": "pass"
          }
        }
      }
    }
  }
}

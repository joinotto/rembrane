{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.rembrane.dev/memory-provider/0.1/conformance.schema.json",
  "title": "Rembrane Memory Provider Conformance Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profileId",
    "protocolVersion",
    "requiredCapabilities",
    "cases"
  ],
  "properties": {
    "profileId": {
      "const": "rembrane.memory-provider.core"
    },
    "protocolVersion": {
      "const": "0.1"
    },
    "requiredCapabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "./memory-provider.schema.json#/$defs/capability"
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "requirement",
        "operation",
        "expected"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]+$",
          "maxLength": 255
        },
        "requirement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "operation": {
          "type": "string",
          "enum": [
            "discovery",
            "resolve_context",
            "propose_memory",
            "delete_memory",
            "sync_pull"
          ]
        },
        "expected": {
          "type": "string",
          "enum": [
            "success",
            "unauthorized",
            "forbidden",
            "conflict",
            "isolated",
            "idempotent",
            "ordered"
          ]
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.rembrane.dev/semantic-provider/0.1/conformance-result.schema.json",
  "title": "Rembrane Semantic Provider Conformance Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "suiteId",
    "suiteVersion",
    "profileSha256",
    "provider",
    "providerVersion",
    "protocolVersion",
    "namespace",
    "result",
    "cases"
  ],
  "properties": {
    "suiteId": {
      "const": "rembrane.semantic-provider.core"
    },
    "suiteVersion": {
      "const": "0.1"
    },
    "profileSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "provider": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]+$",
      "maxLength": 255
    },
    "providerVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "protocolVersion": {
      "const": "0.1"
    },
    "namespace": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,100}$"
    },
    "result": {
      "const": "pass"
    },
    "cases": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "result"
        ],
        "properties": {
          "id": {
            "enum": [
              "manifest.compatible",
              "index.visible",
              "workspace.isolated",
              "replacement.exact",
              "stale-delete.preserves-current",
              "exact-delete.propagates"
            ]
          },
          "result": {
            "const": "pass"
          }
        }
      }
    }
  }
}

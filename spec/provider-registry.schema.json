{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rembrane.dev/spec/provider-registry.schema.json",
  "title": "Rembrane Provider Compatibility Registry",
  "description": "Evidence-backed compatibility records for independently deployable Rembrane provider adapters.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "providers"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "providers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/provider"
      }
    }
  },
  "$defs": {
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "adapterVersion",
        "source",
        "protocolVersions",
        "deploymentModes",
        "plaintextProcessing",
        "status",
        "conformance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[a-z0-9][a-z0-9._-]+$"
        },
        "adapterVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "revision"],
          "properties": {
            "repository": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            "revision": {
              "type": "string",
              "minLength": 7,
              "maxLength": 64,
              "pattern": "^[0-9a-f]+$"
            }
          }
        },
        "protocolVersions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+$"
          }
        },
        "deploymentModes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["embedded", "local-service", "self-hosted", "managed"]
          }
        },
        "plaintextProcessing": {
          "type": "boolean"
        },
        "status": {
          "enum": ["experimental", "compatible", "deprecated", "revoked"]
        },
        "conformance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "result",
            "testedAt",
            "suiteId",
            "suiteVersion",
            "protocolVersion",
            "namespace",
            "cases"
          ],
          "properties": {
            "result": {
              "enum": ["pass", "fail", "not-tested"]
            },
            "testedAt": {
              "type": ["string", "null"],
              "format": "date-time"
            },
            "suiteId": {
              "const": "rembrane.semantic-provider.core"
            },
            "suiteVersion": {
              "const": "0.1"
            },
            "protocolVersion": {
              "const": "0.1"
            },
            "namespace": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]{1,100}$"
            },
            "cases": {
              "type": "array",
              "minItems": 6,
              "maxItems": 6,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "result"],
                "properties": {
                  "id": {
                    "enum": [
                      "manifest.compatible",
                      "index.visible",
                      "workspace.isolated",
                      "replacement.exact",
                      "stale-delete.preserves-current",
                      "exact-delete.propagates"
                    ]
                  },
                  "result": {
                    "enum": ["pass", "fail"]
                  }
                }
              }
            },
            "notes": {
              "type": "string",
              "maxLength": 1000
            }
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rembrane.dev/spec/provider-manifest.schema.json",
  "title": "Rembrane Provider Adapter Manifest",
  "description": "Versioned capability and limit contract for a replaceable semantic-memory provider adapter.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "protocolVersion",
    "capabilities",
    "plaintextProcessing",
    "limits"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[a-z0-9][a-z0-9._-]+$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "protocolVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "index",
          "search",
          "delete",
          "workspace-filter",
          "versioned-records",
          "health-check",
          "export"
        ]
      }
    },
    "plaintextProcessing": {
      "type": "boolean",
      "description": "True when the provider receives decrypted memory content."
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximumBatchItems",
        "maximumContentBytes",
        "maximumCandidates"
      ],
      "properties": {
        "maximumBatchItems": {
          "type": "integer",
          "minimum": 1
        },
        "maximumContentBytes": {
          "type": "integer",
          "minimum": 1
        },
        "maximumCandidates": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.rembrane.dev/memory-provider/0.1/fixtures.schema.json",
  "title": "Rembrane Memory Provider Conformance Fixtures",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fixtureId",
    "profileId",
    "protocolVersion",
    "actors",
    "scenario"
  ],
  "properties": {
    "fixtureId": {
      "const": "rembrane.memory-provider.core.lifecycle"
    },
    "profileId": {
      "const": "rembrane.memory-provider.core"
    },
    "protocolVersion": {
      "const": "0.1"
    },
    "actors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary",
        "otherWorkspace",
        "readOnly"
      ],
      "properties": {
        "primary": {
          "$ref": "#/$defs/actor"
        },
        "otherWorkspace": {
          "$ref": "#/$defs/actor"
        },
        "readOnly": {
          "$ref": "#/$defs/actor"
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contentPrefix",
        "contextPurpose",
        "evidenceSource",
        "sourceReference",
        "observedAtEpochSeconds",
        "staleDeleteReason",
        "exactDeleteReason",
        "cleanupDeleteReason",
        "maximumContextItems",
        "maximumContextBytes",
        "maximumSyncItems"
      ],
      "properties": {
        "contentPrefix": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "contextPurpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "evidenceSource": {
          "$ref": "./memory-provider.schema.json#/$defs/evidenceSource"
        },
        "sourceReference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "observedAtEpochSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "staleDeleteReason": {
          "$ref": "#/$defs/reason"
        },
        "exactDeleteReason": {
          "$ref": "#/$defs/reason"
        },
        "cleanupDeleteReason": {
          "$ref": "#/$defs/reason"
        },
        "maximumContextItems": {
          "type": "integer",
          "minimum": 1
        },
        "maximumContextBytes": {
          "type": "integer",
          "minimum": 1
        },
        "maximumSyncItems": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "$defs": {
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requiredScopes"
      ],
      "properties": {
        "requiredScopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "./memory-provider.schema.json#/$defs/oauthScope"
          }
        }
      }
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    }
  }
}

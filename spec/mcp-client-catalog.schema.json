{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rembrane.dev/spec/mcp-client-catalog.schema.json",
  "title": "Rembrane MCP client catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "clients"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "clients": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/client"
      }
    }
  },
  "$defs": {
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "configFormat", "environmentMode"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "configFormat": {
          "enum": ["toml", "json", "rembrane-stdio-manifest-v1"]
        },
        "environmentMode": {
          "enum": [
            "inherit-allowlist",
            "placeholder",
            "process-inherited",
            "required-environment"
          ]
        }
      }
    }
  }
}

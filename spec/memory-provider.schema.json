{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.rembrane.dev/memory-provider/0.1/schema.json",
  "title": "Rembrane Memory Provider Protocol 0.1",
  "description": "Canonical JSON wire primitives, discovery document, and transport-neutral envelopes for portable memory providers.",
  "oneOf": [
    {
      "$ref": "#/$defs/manifest"
    },
    {
      "$ref": "#/$defs/requestEnvelope"
    },
    {
      "$ref": "#/$defs/successEnvelope"
    },
    {
      "$ref": "#/$defs/errorEnvelope"
    }
  ],
  "$defs": {
    "safeOpaqueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[\\x21-\\x7E]+$"
    },
    "portableId": {
      "type": "string",
      "minLength": 2,
      "maxLength": 255,
      "pattern": "^[a-z0-9][a-z0-9._-]+$"
    },
    "requestId": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "protocolVersion": {
      "const": "0.1"
    },
    "operation": {
      "type": "string",
      "enum": [
        "resolve_context",
        "resolve_question",
        "record_event",
        "propose_memory",
        "checkpoint_activity",
        "record_disclosure",
        "delete_memory",
        "explain_memory",
        "sync_pull",
        "sync_push"
      ]
    },
    "capability": {
      "$ref": "#/$defs/operation"
    },
    "oauthScope": {
      "type": "string",
      "enum": [
        "memory:context:read",
        "memory:question:read",
        "memory:event:write",
        "memory:proposal:write",
        "memory:checkpoint:write",
        "memory:disclosure:write",
        "memory:memory:delete",
        "memory:memory:explain",
        "memory:sync:read",
        "memory:sync:write"
      ]
    },
    "transport": {
      "type": "string",
      "enum": [
        "https",
        "mcp"
      ]
    },
    "privacyMode": {
      "type": "string",
      "enum": [
        "end_to_end_encrypted",
        "trusted_boundary",
        "provider_plaintext"
      ]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximumContextItems",
        "maximumContextBytes",
        "maximumEventBatchItems",
        "maximumSyncBatchItems"
      ],
      "properties": {
        "maximumContextItems": {
          "type": "integer",
          "minimum": 1
        },
        "maximumContextBytes": {
          "type": "integer",
          "minimum": 1
        },
        "maximumEventBatchItems": {
          "type": "integer",
          "minimum": 1
        },
        "maximumSyncBatchItems": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "selector": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope"
          ],
          "properties": {
            "scope": {
              "const": "global"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope",
            "domain"
          ],
          "properties": {
            "scope": {
              "const": "domain"
            },
            "domain": {
              "$ref": "#/$defs/portableId"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope",
            "entityId"
          ],
          "properties": {
            "scope": {
              "const": "entity"
            },
            "entityId": {
              "$ref": "#/$defs/safeOpaqueId"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope",
            "activityId"
          ],
          "properties": {
            "scope": {
              "const": "activity"
            },
            "activityId": {
              "$ref": "#/$defs/safeOpaqueId"
            }
          }
        }
      ]
    },
    "operationBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "capability",
        "oauthScope",
        "httpMethod",
        "pathTemplate"
      ],
      "properties": {
        "operation": {
          "$ref": "#/$defs/operation"
        },
        "capability": {
          "$ref": "#/$defs/capability"
        },
        "oauthScope": {
          "$ref": "#/$defs/oauthScope"
        },
        "httpMethod": {
          "type": "string",
          "enum": [
            "GET",
            "POST",
            "DELETE"
          ]
        },
        "pathTemplate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^/v1/"
        }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "providerId",
        "providerVersion",
        "protocolVersion",
        "transports",
        "capabilities",
        "privacyMode",
        "supportedDomains",
        "limits",
        "operations"
      ],
      "properties": {
        "providerId": {
          "$ref": "#/$defs/portableId"
        },
        "providerVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[\\x20-\\x7E]+$"
        },
        "protocolVersion": {
          "$ref": "#/$defs/protocolVersion"
        },
        "transports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/transport"
          }
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/capability"
          }
        },
        "privacyMode": {
          "$ref": "#/$defs/privacyMode"
        },
        "supportedDomains": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/portableId"
          }
        },
        "limits": {
          "$ref": "#/$defs/limits"
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/operationBinding"
          }
        }
      }
    },
    "positiveVersion": {
      "type": "integer",
      "minimum": 1
    },
    "boundedText4096": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\u0000]+$"
    },
    "boundedText32768": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32768,
      "pattern": "^[^\\u0000]+$"
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "memoryKind": {
      "type": "string",
      "enum": [
        "preference",
        "semantic",
        "episodic",
        "procedural",
        "observation",
        "working"
      ]
    },
    "evidenceSource": {
      "type": "string",
      "enum": [
        "user_statement",
        "agent_observation",
        "tool_result",
        "imported_record",
        "workspace_decision"
      ]
    },
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceId",
        "source"
      ],
      "properties": {
        "evidenceId": {
          "$ref": "#/$defs/safeOpaqueId"
        },
        "source": {
          "$ref": "#/$defs/evidenceSource"
        }
      }
    },
    "exactMemoryRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memoryId",
        "version"
      ],
      "properties": {
        "memoryId": {
          "$ref": "#/$defs/safeOpaqueId"
        },
        "version": {
          "$ref": "#/$defs/positiveVersion"
        }
      }
    },
    "sensitivity": {
      "type": "string",
      "enum": [
        "personal",
        "sensitive",
        "restricted"
      ]
    },
    "disclosureConstraint": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "enum": [
                "purpose_bound",
                "no_training",
                "no_retention"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "expiresAtEpochSeconds"
          ],
          "properties": {
            "type": {
              "const": "expires_at"
            },
            "expiresAtEpochSeconds": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ]
    },
    "contextItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memoryId",
        "version",
        "scope",
        "kind",
        "content",
        "evidence",
        "confidenceMillionths",
        "sensitivity",
        "disclosureConstraints"
      ],
      "properties": {
        "memoryId": {
          "$ref": "#/$defs/safeOpaqueId"
        },
        "version": {
          "$ref": "#/$defs/positiveVersion"
        },
        "scope": {
          "$ref": "#/$defs/selector"
        },
        "kind": {
          "$ref": "#/$defs/memoryKind"
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 262144,
          "pattern": "^[^\\u0000]+$"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidenceReference"
          }
        },
        "confidenceMillionths": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "validFromEpochSeconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "validUntilEpochSeconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "sensitivity": {
          "$ref": "#/$defs/sensitivity"
        },
        "disclosureConstraints": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/disclosureConstraint"
          }
        }
      }
    },
    "resolveContextPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "query",
        "selector",
        "maximumItems",
        "maximumBytes"
      ],
      "properties": {
        "purpose": {
          "$ref": "#/$defs/boundedText4096"
        },
        "query": {
          "$ref": "#/$defs/boundedText32768"
        },
        "selector": {
          "$ref": "#/$defs/selector"
        },
        "maximumItems": {
          "type": "integer",
          "minimum": 1
        },
        "maximumBytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "resolveContextResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contextPackId",
        "disclosureId",
        "items"
      ],
      "properties": {
        "contextPackId": {
          "$ref": "#/$defs/safeOpaqueId"
        },
        "disclosureId": {
          "$ref": "#/$defs/safeOpaqueId"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contextItem"
          }
        }
      }
    },
    "resolveQuestionPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "question",
        "selector",
        "maximumSupportingItems",
        "maximumAnswerBytes"
      ],
      "properties": {
        "purpose": {
          "$ref": "#/$defs/boundedText4096"
        },
        "question": {
          "$ref": "#/$defs/boundedText32768"
        },
        "selector": {
          "$ref": "#/$defs/selector"
        },
        "maximumSupportingItems": {
          "type": "integer",
          "minimum": 1
        },
        "maximumAnswerBytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "resolveQuestionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "answer",
        "supportingMemories",
        "contextPackId",
        "disclosureId"
      ],
      "properties": {
        "answer": {
          "$ref": "#/$defs/boundedText32768"
        },
        "supportingMemories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/exactMemoryRevision"
          }
        },
        "contextPackId": {
          "$ref": "#/$defs/safeOpaqueId"
        },
        "disclosureId": {
          "$ref": "#/$defs/safeOpaqueId"
        }
      }
    },
    "deleteMemoryPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "idempotencyKey",
        "memoryId",
        "expectedVersion",
        "reason"
      ],
      "properties": {
        "idempotencyKey": {
          "$ref": "#/$defs/idempotencyKey"
        },
        "memoryId": {
          "$ref": "#/$defs/safeOpaqueId"
        },
        "expectedVersion": {
          "$ref": "#/$defs/positiveVersion"
        },
        "reason": {
          "$ref": "#/$defs/boundedText4096"
        }
      }
    },
    "deleteMemoryResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memoryId",
        "deletedVersion",
        "tombstoneVersion"
      ],
      "properties": {
        "memoryId": {
          "$ref": "#/$defs/safeOpaqueId"
        },
        "deletedVersion": {
          "$ref": "#/$defs/positiveVersion"
        },
        "tombstoneVersion": {
          "$ref": "#/$defs/positiveVersion"
        }
      }
    },
    "explainMemoryPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memoryId",
        "version",
        "purpose"
      ],
      "properties": {
        "memoryId": {
          "$ref": "#/$defs/safeOpaqueId"
        },
        "version": {
          "$ref": "#/$defs/positiveVersion"
        },
        "purpose": {
          "$ref": "#/$defs/boundedText4096"
        }
      }
    },
    "explainMemoryResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memoryId",
        "version",
        "explanation",
        "evidence"
      ],
      "properties": {
        "memoryId": {
          "$ref": "#/$defs/safeOpaqueId"
        },
        "version": {
          "$ref": "#/$defs/positiveVersion"
        },
        "explanation": {
          "$ref": "#/$defs/boundedText32768"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidenceReference"
          }
        }
      }
    },
    "optionalSourceReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
    },
    "memoryEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventType",
        "selector",
        "data",
        "observedAtEpochSeconds"
      ],
      "properties": {
        "eventType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "selector": {
          "$ref": "#/$defs/selector"
        },
        "data": {
          "type": "string",
          "minLength": 1,
          "maxLength": 262144,
          "pattern": "^[^\\u0000]+$"
        },
        "sourceReference": {
          "$ref": "#/$defs/optionalSourceReference"
        },
        "observedAtEpochSeconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "recordEventPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "idempotencyKey",
        "events"
      ],
      "properties": {
        "idempotencyKey": {
          "$ref": "#/$defs/idempotencyKey"
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/memoryEvent"
          }
        }
      }
    },
    "recordedEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventId",
        "sequence"
      ],
      "properties": {
        "eventId": {
          "$ref": "#/$defs/safeOpaqueId"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "recordEventResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "events"
      ],
      "properties": {
        "events": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/recordedEvent"
          }
        }
      }
    },
    "proposeMemoryPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "idempotencyKey",
        "selector",
        "kind",
        "content",
        "evidenceSource",
        "observedAtEpochSeconds"
      ],
      "properties": {
        "idempotencyKey": {
          "$ref": "#/$defs/idempotencyKey"
        },
        "selector": {
          "$ref": "#/$defs/selector"
        },
        "kind": {
          "$ref": "#/$defs/memoryKind"
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 262144,
          "pattern": "^[^\\u0000]+$"
        },
        "evidenceSource": {
          "$ref": "#/$defs/evidenceSource"
        },
        "sourceReference": {
          "$ref": "#/$defs/optionalSourceReference"
        },
        "observedAtEpochSeconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "proposeMemoryResult": {
      "$ref": "#/$defs/exactMemoryRevision"
    },
    "checkpointActivityPayload": {
      "description": "The combined UTF-8 byte length of goal, summary, nextSteps, blockers, and stateFingerprint must not exceed 262144 bytes.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "idempotencyKey",
            "activityId",
            "goal",
            "summary",
            "nextSteps",
            "blockers"
          ],
          "properties": {
            "idempotencyKey": {
              "$ref": "#/$defs/idempotencyKey"
            },
            "activityId": {
              "$ref": "#/$defs/safeOpaqueId"
            },
            "entityId": {
              "$ref": "#/$defs/safeOpaqueId"
            },
            "goal": {
              "type": "string",
              "minLength": 1,
              "maxLength": 262144,
              "pattern": "^[^\\u0000]+$"
            },
            "summary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 262144,
              "pattern": "^[^\\u0000]+$"
            },
            "nextSteps": {
              "$ref": "#/$defs/checkpointTextList"
            },
            "blockers": {
              "$ref": "#/$defs/checkpointTextList"
            },
            "stateFingerprint": {
              "type": "string",
              "minLength": 1,
              "maxLength": 262144,
              "pattern": "^[^\\u0000]+$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "idempotencyKey",
            "activityId",
            "expectedVersion",
            "summary",
            "nextSteps",
            "blockers"
          ],
          "properties": {
            "idempotencyKey": {
              "$ref": "#/$defs/idempotencyKey"
            },
            "activityId": {
              "$ref": "#/$defs/safeOpaqueId"
            },
            "entityId": {
              "$ref": "#/$defs/safeOpaqueId"
            },
            "expectedVersion": {
              "$ref": "#/$defs/positiveVersion"
            },
            "summary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 262144,
              "pattern": "^[^\\u0000]+$"
            },
            "nextSteps": {
              "$ref": "#/$defs/checkpointTextList"
            },
            "blockers": {
              "$ref": "#/$defs/checkpointTextList"
            },
            "stateFingerprint": {
              "type": "string",
              "minLength": 1,
              "maxLength": 262144,
              "pattern": "^[^\\u0000]+$"
            }
          }
        }
      ]
    },
    "checkpointTextList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 262144,
        "pattern": "^[^\\u0000]+$"
      }
    },
    "checkpointActivityResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkpointId",
        "version"
      ],
      "properties": {
        "checkpointId": {
          "$ref": "#/$defs/safeOpaqueId"
        },
        "version": {
          "$ref": "#/$defs/positiveVersion"
        }
      }
    },
    "recordDisclosurePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "idempotencyKey",
        "contextPackId",
        "purpose",
        "memories",
        "disclosedAtEpochSeconds"
      ],
      "properties": {
        "idempotencyKey": {
          "$ref": "#/$defs/idempotencyKey"
        },
        "contextPackId": {
          "$ref": "#/$defs/safeOpaqueId"
        },
        "purpose": {
          "$ref": "#/$defs/boundedText4096"
        },
        "memories": {
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/exactMemoryRevision"
          }
        },
        "disclosedAtEpochSeconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "recordDisclosureResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disclosureId"
      ],
      "properties": {
        "disclosureId": {
          "$ref": "#/$defs/safeOpaqueId"
        }
      }
    },
    "syncCursor": {
      "type": "string",
      "minLength": 16,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "syncResource": {
      "type": "string",
      "enum": [
        "memory",
        "evidence",
        "activity_checkpoint",
        "disclosure_receipt",
        "entity",
        "event"
      ]
    },
    "syncPayload": {
      "type": "string",
      "minLength": 1,
      "maxLength": 262144,
      "pattern": "^[^\\u0000]+$"
    },
    "sha256Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "pulledSyncChange": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "changeId",
            "sequence",
            "resource",
            "resourceId",
            "version",
            "operation",
            "payload",
            "payloadSha256"
          ],
          "properties": {
            "changeId": {

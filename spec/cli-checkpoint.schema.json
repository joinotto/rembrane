{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rembrane.dev/spec/cli-checkpoint.schema.json",
  "title": "Rembrane CLI checkpoint and resume result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "checkpointId",
    "activityId",
    "entityId",
    "goal",
    "summary",
    "nextSteps",
    "blockers",
    "stateFingerprint",
    "version",
    "stale",
    "disclosureId"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "checkpointId": { "$ref": "#/$defs/opaqueId" },
    "activityId": { "$ref": "#/$defs/opaqueId" },
    "entityId": {
      "oneOf": [
        { "$ref": "#/$defs/opaqueId" },
        { "type": "null" }
      ]
    },
    "goal": { "$ref": "#/$defs/requiredText" },
    "summary": { "$ref": "#/$defs/requiredText" },
    "nextSteps": { "$ref": "#/$defs/textList" },
    "blockers": { "$ref": "#/$defs/textList" },
    "stateFingerprint": {
      "oneOf": [
        { "$ref": "#/$defs/requiredText" },
        { "type": "null" }
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "stale": {
      "type": ["boolean", "null"]
    },
    "disclosureId": {
      "oneOf": [
        { "$ref": "#/$defs/opaqueId" },
        { "type": "null" }
      ]
    }
  },
  "$defs": {
    "opaqueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
    },
    "requiredText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 262144
    },
    "textList": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "string",
        "maxLength": 262144
      }
    }
  },
  "x-rembrane-maximumPayloadBytes": 262144,
  "x-rembrane-maximumCombinedListItems": 1024
}

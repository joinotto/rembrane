{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rembrane.dev/spec/cli-checkpoint.schema.json",
  "title": "Rembrane CLI checkpoint and resume result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "checkpointId": { "$ref": "#/$defs/opaqueId" },
    "activityId": { "$ref": "#/$defs/opaqueId" },
    "entityId": {
      "oneOf": [
        { "$ref": "#/$defs/opaqueId" },
        { "type": "null" }
      ]
    },
    "goal": { "$ref": "#/$defs/requiredText" },
    "summary": { "$ref": "#/$defs/requiredText" },
    "nextSteps": { "$ref": "#/$defs/textList" },
    "blockers": { "$ref": "#/$defs/textList" },
    "stateFingerprint": {
      "oneOf": [
        { "$ref": "#/$defs/requiredText" },
        { "type": "null" }
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "stale": {
      "type": ["boolean", "null"]
    },
    "disclosureId": {
      "oneOf": [
        { "$ref": "#/$defs/opaqueId" },
        { "type": "null" }
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": {
          "enum": ["checkpoint_failed", "resume_failed"]
        }
      }
    }
  },
  "$defs": {
    "opaqueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[\\u0021-\\u007E]+$"
    },
    "requiredText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 262144,
      "pattern": "^(?=.*\\S)[^\\u0000]+$"
    },
    "textList": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 262144,
        "pattern": "^(?=.*\\S)[^\\u0000]+$"
      }
    }
  },
  "oneOf": [
    {
      "required": [
        "checkpointId",
        "activityId",
        "entityId",
        "goal",
        "summary",
        "nextSteps",
        "blockers",
        "stateFingerprint",
        "version",
        "stale",
        "disclosureId"
      ],
      "not": {
        "required": ["error"]
      }
    },
    {
      "required": ["error"],
      "not": {
        "anyOf": [
          { "required": ["checkpointId"] },
          { "required": ["activityId"] },
          { "required": ["entityId"] },
          { "required": ["goal"] },
          { "required": ["summary"] },
          { "required": ["nextSteps"] },
          { "required": ["blockers"] },
          { "required": ["stateFingerprint"] },
          { "required": ["version"] },
          { "required": ["stale"] },
          { "required": ["disclosureId"] }
        ]
      }
    }
  ],
  "x-rembrane-maximumPayloadBytes": 262144,
  "x-rembrane-maximumCombinedListItems": 1024
}

{
  "info": {
    "_postman_id": "ce2f71b5-f938-4ef5-91f8-c7747ab15ec1",
    "name": "Rembrane Local API",
    "description": "Pre-alpha authenticated local REST conformance checks.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('health is available', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().status).to.eql('ok');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject missing bearer token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"workspaceId\":\"{{workspaceId}}\",\"subjectId\":\"{{principalId}}\",\"purpose\":\"personalize-assistant\",\"query\":\"What should I call the user?\",\"maximumItems\":10}"
        },
        "url": "{{baseUrl}}/v1/context/resolve"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('missing token is rejected', function () {",
              "  pm.response.to.have.status(401);",
              "  pm.expect(pm.response.json().code).to.eql('unauthenticated');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Resolve authorized context",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{apiToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"workspaceId\":\"{{workspaceId}}\",\"subjectId\":\"{{principalId}}\",\"purpose\":\"personalize-assistant\",\"query\":\"What should I call the user?\",\"maximumItems\":10}"
        },
        "url": "{{baseUrl}}/v1/context/resolve"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('authorized context is returned', function () {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  pm.expect(body.contextPackId).to.be.a('string');",
              "  pm.expect(body.disclosureId).to.be.a('string');",
              "  pm.expect(body.items).to.have.lengthOf(1);",
              "  pm.expect(body.items[0].content).to.eql('Call me Hippo');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject cross-workspace request",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{apiToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"workspaceId\":\"workspace_other\",\"subjectId\":\"{{principalId}}\",\"purpose\":\"personalize-assistant\",\"query\":\"What should I call the user?\",\"maximumItems\":10}"
        },
        "url": "{{baseUrl}}/v1/context/resolve"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('cross-workspace request is denied', function () {",
              "  pm.response.to.have.status(403);",
              "  pm.expect(pm.response.json().code).to.eql('access_denied');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Create bounded workspace invitation",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{apiToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"workspaceId\":\"{{workspaceId}}\",\"invitationId\":\"{{invitationId}}\",\"invitedPrincipalId\":\"{{invitedPrincipalId}}\",\"role\":\"member\",\"ttlSeconds\":3600,\"requestId\":\"request_invitation_create_rest_e2e\"}"
        },
        "url": "{{baseUrl}}/v1/workspaces/invitations"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('bounded invitation is created for the exact workspace', function () {",
              "  pm.response.to.have.status(201);",
              "  const body = pm.response.json();",
              "  pm.expect(body.workspaceId).to.eql(pm.variables.get('workspaceId'));",
              "  pm.expect(body.invitationId).to.eql(pm.variables.get('invitationId'));",
              "  pm.expect(body.invitedPrincipalId).to.eql(pm.variables.get('invitedPrincipalId'));",
              "  pm.expect(body.role).to.eql('member');",
              "  pm.expect(body.status).to.eql('pending');",
              "  pm.expect(body.expiresAtEpochSeconds).to.be.a('number');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Revoke pending workspace invitation",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{apiToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"workspaceId\":\"{{workspaceId}}\",\"invitationId\":\"{{invitationId}}\",\"requestId\":\"request_invitation_revoke_rest_e2e\"}"
        },
        "url": "{{baseUrl}}/v1/workspaces/invitations/revoke"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('pending invitation is revoked by the workspace owner', function () {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  pm.expect(body.workspaceId).to.eql(pm.variables.get('workspaceId'));",
              "  pm.expect(body.invitationId).to.eql(pm.variables.get('invitationId'));",
              "  pm.expect(body.status).to.eql('revoked');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject research for missing canonical trip",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{apiToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"workspaceId\":\"{{workspaceId}}\",\"subjectId\":\"{{principalId}}\",\"tripId\":\"{{tripId}}\",\"kind\":\"flight\",\"provider\":\"postman-search\",\"summary\":\"Nonstop morning option\",\"sourceReference\":\"opaque-result-postman\",\"evidenceSource\":\"tool-result\",\"observedAt\":\"2026-10-25T10:00:00Z\",\"expiresAt\":\"2026-10-25T10:30:00Z\",\"expectedPreviousSequence\":2}"
        },
        "url": "{{baseUrl}}/v1/travel/booking-research"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('missing canonical trip is rejected', function () {",
              "  pm.response.to.have.status(404);",
              "  pm.expect(pm.response.json().code).to.eql('not_found');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Create encrypted trip",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{apiToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"workspaceId\":\"{{workspaceId}}\",\"subjectId\":\"{{principalId}}\",\"title\":\"Kyoto continuity test\",\"origin\":\"Bengaluru\",\"destinations\":[\"Kyoto\"],\"departNotBefore\":\"2026-11-01\",\"returnNotAfter\":\"2026-11-12\",\"expectedPreviousSequence\":2}"
        },
        "url": "{{baseUrl}}/v1/travel/trips"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('encrypted trip is created', function () {",
              "  pm.response.to.have.status(201);",
              "  const body = pm.response.json();",
              "  pm.expect(body.tripId).to.be.a('string');",
              "  pm.expect(body.version).to.eql(1);",
              "  pm.collectionVariables.set('createdTripId', body.tripId);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Add trip participant",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{apiToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"workspaceId\":\"{{workspaceId}}\",\"subjectId\":\"{{principalId}}\",\"tripId\":\"{{createdTripId}}\",\"label\":\"Hippo\",\"expectedTripVersion\":1,\"expectedPreviousSequence\":3}"
        },
        "url": "{{baseUrl}}/v1/travel/trip-participants"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('participant is added with an optimistic narrow mutation', function () {",
              "  pm.response.to.have.status(201);",
              "  const body = pm.response.json();",
              "  pm.expect(body.tripId).to.eql(pm.collectionVariables.get('createdTripId'));",
              "  pm.expect(body.participantId).to.be.a('string');",
              "  pm.expect(body.tripVersion).to.eql(2);",
              "  pm.collectionVariables.set('createdParticipantId', body.participantId);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Add evidence-backed trip constraint",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{apiToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"workspaceId\":\"{{workspaceId}}\",\"subjectId\":\"{{principalId}}\",\"tripId\":\"{{createdTripId}}\",\"participantId\":\"{{createdParticipantId}}\",\"kind\":\"dietary\",\"statement\":\"Vegetarian meals\",\"evidenceSource\":\"user-statement\",\"expectedTripVersion\":2,\"expectedPreviousSequence\":4}"
        },
        "url": "{{baseUrl}}/v1/travel/trip-constraints"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('constraint is added without replacing trip state', function () {",
              "  pm.response.to.have.status(201);",
              "  const body = pm.response.json();",
              "  pm.expect(body.recordId).to.be.a('string');",
              "  pm.expect(body.tripVersion).to.eql(3);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Record attributed trip decision",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{apiToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"workspaceId\":\"{{workspaceId}}\",\"subjectId\":\"{{principalId}}\",\"tripId\":\"{{createdTripId}}\",\"status\":\"selected\",\"summary\":\"Prefer the nonstop flight\",\"rationale\":\"Simpler handoff\",\"evidenceSource\":\"workspace-decision\",\"expectedTripVersion\":3,\"expectedPreviousSequence\":5}"
        },
        "url": "{{baseUrl}}/v1/travel/trip-decisions"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('decision is attributed by the server', function () {",
              "  pm.response.to.have.status(201);",
              "  const body = pm.response.json();",
              "  pm.expect(body.recordId).to.be.a('string');",
              "  pm.expect(body.tripVersion).to.eql(4);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Capture research for created trip",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{apiToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"workspaceId\":\"{{workspaceId}}\",\"subjectId\":\"{{principalId}}\",\"tripId\":\"{{createdTripId}}\",\"kind\":\"flight\",\"provider\":\"postman-search\",\"summary\":\"Nonstop morning option\",\"sourceReference\":\"opaque-result-success\",\"evidenceSource\":\"tool-result\",\"observedAt\":\"2026-10-25T10:00:00Z\",\"expiresAt\":\"2026-10-25T10:30:00Z\",\"expectedPreviousSequence\":6}"
        },
        "url": "{{baseUrl}}/v1/travel/booking-research"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('research is captured for the created trip', function () {",
              "  pm.response.to.have.status(201);",
              "  const body = pm.response.json();",
              "  pm.expect(body.tripId).to.eql(pm.collectionVariables.get('createdTripId'));",
              "  pm.expect(body.version).to.eql(1);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Resolve audited travel context",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{apiToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"workspaceId\":\"{{workspaceId}}\",\"subjectId\":\"{{principalId}}\",\"tripId\":\"{{createdTripId}}\",\"purpose\":\"continue flight planning in another assistant\",\"asOf\":\"2026-10-25T10:15:00Z\"}"
        },
        "url": "{{baseUrl}}/v1/travel/context/resolve"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('travel context is audited and minimizes sensitive output', function () {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  pm.expect(body.disclosureId).to.be.a('string');",
              "  pm.expect(body.trip.tripId).to.eql(pm.collectionVariables.get('createdTripId'));",
              "  pm.expect(body.freshResearch).to.have.lengthOf(1);",
              "  pm.expect(body.expiredResearch).to.have.lengthOf(0);",
              "  pm.expect(body.freshResearch[0]).not.to.have.property('sourceReference');",
              "  pm.expect(body.trip).not.to.have.property('sensitiveProfile');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Deny sensitive trip profile without connection permission",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{apiToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"workspaceId\":\"{{workspaceId}}\",\"subjectId\":\"{{principalId}}\",\"tripId\":\"{{createdTripId}}\",\"purpose\":\"coordinate traveller requirements\",\"asOf\":\"2026-10-25T10:15:00Z\",\"includeSensitiveProfile\":true}"
        },
        "url": "{{baseUrl}}/v1/travel/context/resolve"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('sensitive trip profile needs a connection permission', function () {",
              "  pm.response.to.have.status(403);",
              "  pm.expect(pm.response.json().code).to.eql('access_denied');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Deny sensitive travel source without connection permission",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{apiToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"workspaceId\":\"{{workspaceId}}\",\"subjectId\":\"{{principalId}}\",\"tripId\":\"{{createdTripId}}\",\"purpose\":\"reopen the provider result\",\"asOf\":\"2026-10-25T10:15:00Z\",\"includeSourceReferences\":true}"
        },
        "url": "{{baseUrl}}/v1/travel/context/resolve"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('sensitive travel source needs a connection permission', function () {",
              "  pm.response.to.have.status(403);",
              "  pm.expect(pm.response.json().code).to.eql('access_denied');",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
